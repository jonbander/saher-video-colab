# Keep the service bound to loopback unless it is protected by an authenticated gateway.
SAHER_HOST=127.0.0.1
SAHER_PORT=8000

# URL of a privately reachable ComfyUI server; do not expose it directly to the public internet.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=workflows/your-approved-workflow-api.json
COMFYUI_PROMPT_NODE_ID=6
COMFYUI_PROMPT_INPUT=text
COMFYUI_TIMEOUT_SECONDS=30
